<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tshin.ViewModels"
        x:Class="Tshin.Views.PlayerWindow"
        x:DataType="vm:PlayerViewModel"
        Title="Tshin — Play"
        Width="700" Height="520"
        MinWidth="480" MinHeight="340"
        Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid ColumnDefinitions="*,Auto">
        <!-- Story area -->
        <Border Grid.Column="0" Margin="24" Background="{StaticResource CardBgBrush}"
                CornerRadius="14" Padding="28" BoxShadow="0 8 32 0 #60000000">
            <DockPanel>
                <!-- Story text -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentNode.DisplayText}"
                           FontSize="20" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,24" />

                <!-- End-of-branch -->
                <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding IsEnd}" Spacing="14">
                    <TextBlock Text="The End" FontSize="14" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="Restart" Classes="accent" HorizontalAlignment="Center"
                            Command="{Binding RestartCommand}" />
                </StackPanel>

                <!-- Choices -->
                <ItemsControl ItemsSource="{Binding CurrentNode.Choices}" IsVisible="{Binding !IsEnd}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceViewModel">
                            <Button Content="{Binding DisplayText}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14" FontSize="15"
                                    Command="{Binding $parent[ItemsControl].((vm:PlayerViewModel)DataContext).ChooseCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Entities panel (collapsible) -->
        <Border Grid.Column="1" Background="{StaticResource ContentBgBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0"
                IsVisible="{Binding HasVisibleEntities}">
            <DockPanel MinWidth="180">
                <!-- Header toggle -->
                <Button DockPanel.Dock="Top" Classes="ghost" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="14,12"
                        Command="{Binding ToggleEntitiesPanelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding EntitiesToggleGlyph}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Entities" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Entity list -->
                <ScrollViewer IsVisible="{Binding IsEntitiesPanelExpanded}">
                    <ItemsControl ItemsSource="{Binding VisiblePlayEntities}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntityViewModel">
                                <StackPanel Margin="12,4">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,4,0,4" />
                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComponentViewModel">
                                                <Border Margin="0,2" Padding="8,4"
                                                        Background="{StaticResource ControlBgBrush}"
                                                        CornerRadius="4"
                                                        IsVisible="{Binding Visible}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
