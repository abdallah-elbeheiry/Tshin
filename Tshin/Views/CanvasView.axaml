<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tshin.ViewModels"
             xmlns:conv="clr-namespace:Tshin.Converters"
             x:Class="Tshin.Views.CanvasView"
             x:DataType="vm:EditorViewModel"
             Focusable="True">

    <UserControl.Resources>
        <conv:ComponentTypeToIconConverter x:Key="ComponentTypeIcon" />
        <conv:BoolToGeometryConverter x:Key="BoolToGeometry" />
    </UserControl.Resources>

    <!-- The node canvas keeps a fixed dark identity on every platform and in either OS theme;
         only the surrounding chrome, toolbar, and inspector follow the system theme. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <!-- Viewport: receives pan / zoom / background interactions. The dot-grid
             VisualBrush is painted entirely in code (UpdateGridBackground); no XAML
             background, so a late DynamicResource re-resolve under the ThemeVariantScope
             can't clobber it (which left the grid blank until the first interaction). -->
        <Border x:Name="Viewport" ClipToBounds="True"
                PointerPressed="OnViewportPressed" PointerMoved="OnViewportMoved"
                PointerReleased="OnViewportReleased" PointerWheelChanged="OnViewportWheel">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Create Node" Click="OnCreateNodeClick" />
                    <MenuItem Header="Create Entity" Click="OnCreateEntityClick" />
                </ContextMenu>
            </Border.ContextMenu>

            <!-- World space (pan + zoom applied here). It's a large fixed canvas
                 (NodeLayout.CanvasSize) whose CENTRE is world origin: cards are laid
                 out at world + CanvasBias so they always sit inside the canvas bounds
                 and Avalonia never culls them, in any drag direction. The translate
                 subtracts CanvasBias*Zoom (RenderOffset) so the view is unchanged. -->
            <Panel x:Name="World" Width="{x:Static vm:NodeLayout.CanvasSize}"
                   Height="{x:Static vm:NodeLayout.CanvasSize}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   ClipToBounds="False" RenderTransformOrigin="0,0">
                <Panel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        <TranslateTransform X="{Binding RenderOffsetX}" Y="{Binding RenderOffsetY}" />
                    </TransformGroup>
                </Panel.RenderTransform>

                <!-- Wires (behind nodes) -->
                <ItemsControl ItemsSource="{Binding Connections}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{x:Static vm:NodeLayout.CanvasSize}" Height="{x:Static vm:NodeLayout.CanvasSize}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionViewModel">
                            <Grid>
                                <Path Data="{Binding Geometry}" Stroke="{Binding Stroke}"
                                      StrokeThickness="2" />
                                <Path Data="M 0,0 L -10,-6 M 0,0 L -10,6"
                                      Stroke="{Binding Stroke}" StrokeThickness="2">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform X="{Binding ArrowTip.X}"
                                                                 Y="{Binding ArrowTip.Y}" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Temp wire shown while dragging a connection -->
                <Path x:Name="TempWire" Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="2"
                      StrokeDashArray="4,3" IsVisible="False" />

                <!-- Entity cards (node-like layout, blue theme) -->
                <ItemsControl ItemsSource="{Binding Entities}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{x:Static vm:NodeLayout.CanvasSize}" Height="{x:Static vm:NodeLayout.CanvasSize}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:EntityViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntityViewModel">
                            <Border Classes="card entity"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.hidden="{Binding !Visible}">
                                <StackPanel>
                                    <!-- Header (entity accent) — draggable -->
                                    <Panel Height="34" PointerPressed="OnEntityHeaderPressed">
                                        <Border CornerRadius="10,10,0,0" Background="{DynamicResource EntityHeaderBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" Margin="14,0,6,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                            <ToggleButton Grid.Column="1" Classes="visibility"
                                                          IsChecked="{Binding Visible}"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="Shown at runtime">
                                                <Path Width="14" Height="14" Stretch="Uniform"
                                                      Fill="White"
                                                      Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                            </ToggleButton>
                                        </Grid>
                                    </Panel>

                                    <!-- Component rows — clickable -->
                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComponentViewModel">
                                                <Border Margin="8,3,8,0" Padding="8,4"
                                                        Background="{DynamicResource ControlBgBrush}"
                                                        CornerRadius="6" Classes="row"
                                                        Classes.hidden="{Binding !Visible}"
                                                        PointerPressed="OnComponentBadgePressed">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                        <Border Grid.Column="0" Background="{DynamicResource EntityAccentBrush}"
                                                                CornerRadius="3" Width="18" Height="18"
                                                                VerticalAlignment="Center">
                                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Text="{Binding ComponentType, Converter={StaticResource ComponentTypeIcon}}"
                                                                       ToolTip.Tip="{Binding ComponentType}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <ToggleButton Grid.Column="2" Classes="visibility"
                                                                      IsChecked="{Binding Visible}"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="Shown at runtime">
                                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                                        </ToggleButton>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ Component" Classes="ghost" Margin="8,4,8,8"
                                            HorizontalAlignment="Stretch" FontSize="11"
                                            Click="OnAddComponentClick"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nodes -->
                <ItemsControl ItemsSource="{Binding Nodes}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{x:Static vm:NodeLayout.CanvasSize}" Height="{x:Static vm:NodeLayout.CanvasSize}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:NodeViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NodeViewModel">
                            <Border Classes="card node"
                                    Classes.selected="{Binding IsSelected}">
                                <StackPanel>
                                    <!-- Header -->
                                    <Panel Height="{x:Static vm:NodeLayout.HeaderHeight}" PointerPressed="OnNodeHeaderPressed">
                                        <Border CornerRadius="10,10,0,0" Background="{DynamicResource HeaderOverlayBrush}" />
                                        <TextBlock Text="{Binding Id}" Margin="14,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <!-- Input pin -->
                                        <Ellipse Width="12" Height="12" Margin="-6,0,0,0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Fill="{DynamicResource ControlBgBrush}"
                                                 Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                                 PointerPressed="OnInputPinPressed" />
                                    </Panel>

                                    <!-- Display text -->
                                    <Border Height="{x:Static vm:NodeLayout.TextAreaHeight}" Padding="8,4">
                                        <TextBox Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                 AcceptsReturn="True" FontSize="12" BorderThickness="0"
                                                 Background="Transparent" Padding="4" />
                                    </Border>

                                    <!-- Choices -->
                                    <ItemsControl ItemsSource="{Binding Choices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChoiceViewModel">
                                                <Panel Height="{x:Static vm:NodeLayout.ChoiceRowHeight}">
                                                    <!-- Each choice is its own block -->
                                                    <Border Margin="8,5,14,5"
                                                            Background="{DynamicResource ControlBgBrush}"
                                                            CornerRadius="6" Padding="6,0"
                                                            Classes.selected="{Binding IsSelected}">
                                                        <Border.Styles>
                                                            <Style Selector="Border.selected">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </Style>
                                                        </Border.Styles>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBox Grid.Column="0" Text="{Binding DisplayText}"
                                                                     FontSize="11" Padding="4,2"
                                                                     Background="Transparent" BorderThickness="0"
                                                                     VerticalContentAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        Spacing="2" VerticalAlignment="Center">
                                                                <Button Classes="icon"
                                                                        Command="{Binding OpenInspectorCommand}"
                                                                        ToolTip.Tip="Edit choice">
                                                                    <Path Classes="glyph" Data="{StaticResource GearIcon}" />
                                                                </Button>
                                                                <Button Classes="icon danger"
                                                                        Command="{Binding RemoveSelfCommand}"
                                                                        ToolTip.Tip="Remove choice">
                                                                    <Path Classes="glyph" Data="{StaticResource CloseIcon}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Output pin -->
                                                    <Ellipse Width="12" Height="12" Margin="0,0,-6,0"
                                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             PointerPressed="OnOutputPinPressed" />
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ choice" Classes="ghost" Margin="8,4,8,8"
                                            HorizontalAlignment="Stretch" FontSize="11"
                                            Command="{Binding AddChoiceViaEditorCommand}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </Border>
    </ThemeVariantScope>
</UserControl>
