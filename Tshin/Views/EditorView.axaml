<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tshin.ViewModels"
             xmlns:conv="clr-namespace:Tshin.Converters"
             x:Class="Tshin.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Focusable="True">

    <UserControl.Resources>
        <conv:ComponentTypeToIconConverter x:Key="ComponentTypeIcon" />
        <conv:ComponentTypeVisibilityConverter x:Key="ComponentTypeVisibility" />
        <conv:BoolToGeometryConverter x:Key="BoolToGeometry" />
        <conv:NumericSafeConverter x:Key="NumericSafe" />
        <conv:MaxValueConverter x:Key="MaxValueDisplay" />
    </UserControl.Resources>

    <!-- Implicit (type-keyed) templates for the recursive condition editor. The group
         template hosts an ItemsControl over Children with NO ItemTemplate, so each child
         falls back to these implicit templates → the AND/OR nesting renders recursively. -->
    <UserControl.DataTemplates>

        <!-- Atomic condition: entity → component → operator → value -->
        <DataTemplate x:DataType="vm:AtomicConditionViewModel">
            <Border Margin="0,2" Padding="6"
                    Background="{StaticResource ControlBgBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Condition" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Classes="icon danger"
                                Command="{Binding RemoveSelfCommand}"
                                ToolTip.Tip="Remove condition" />
                    </Grid>

                    <ComboBox ItemsSource="{Binding AvailableEntities}"
                              SelectedItem="{Binding TargetEntity}"
                              DisplayMemberBinding="{Binding Name}"
                              PlaceholderText="Entity" FontSize="11"
                              HorizontalAlignment="Stretch" />

                    <ComboBox ItemsSource="{Binding AvailableComponents}"
                              SelectedItem="{Binding SelectedComponent}"
                              DisplayMemberBinding="{Binding Name}"
                              PlaceholderText="Component" FontSize="11"
                              HorizontalAlignment="Stretch" />

                    <ComboBox ItemsSource="{Binding AvailableOperators}"
                              SelectedItem="{Binding SelectedOperator}"
                              PlaceholderText="Operator" FontSize="11"
                              HorizontalAlignment="Stretch" />

                    <NumericUpDown Value="{Binding NumberValue}"
                                   FormatString="0.##" FontSize="11" Margin="0,2,0,0"
                                   IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='number'}" />

                    <TextBox Text="{Binding TextValue}"
                             PlaceholderText="Enter text" FontSize="11" Margin="0,2,0,0"
                             IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='text'}" />

                    <ToggleSwitch IsChecked="{Binding BoolValue}" Margin="0,2,0,0"
                                  IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='condition'}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Logical group: AND/OR selector + recursive children + add buttons -->
        <DataTemplate x:DataType="vm:LogicalGroupViewModel">
            <Border Margin="0,2" Padding="6"
                    Background="{StaticResource ControlBgBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding LogicOptions}"
                                  SelectedIndex="{Binding SelectedLogicIndex}"
                                  FontSize="11" ToolTip.Tip="AND = all must hold; OR = any holds" />
                        <TextBlock Grid.Column="1" Text="group" FontSize="10" Margin="6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Grid.Column="2" Content="✕" Classes="icon danger"
                                Command="{Binding RemoveSelfCommand}"
                                ToolTip.Tip="Remove group" />
                    </Grid>

                    <!-- Recursive children: no ItemTemplate → implicit templates apply -->
                    <ItemsControl ItemsSource="{Binding Children}" Margin="12,0,0,0" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="+ Condition" Classes="ghost" FontSize="10"
                                Command="{Binding AddAtomicCommand}" />
                        <Button Content="+ Group" Classes="ghost" FontSize="10"
                                Command="{Binding AddGroupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.DataTemplates>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Meta+R" Command="{Binding RunCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RunCommand}" />
        <KeyBinding Gesture="Meta+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <!-- ============ TOOLBAR ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ContentBgBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="16,10" Margin="{StaticResource TitleBarInset}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox Text="{Binding ProjectName}" Classes="title"
                             FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                             MinWidth="60" MaxWidth="280"
                             ToolTip.Tip="Rename epic" />
                    <Border Background="{StaticResource ControlBgBrush}" CornerRadius="4" Padding="6,1"
                            VerticalAlignment="Center" IsVisible="{Binding IsDirty}">
                        <TextBlock Text="Edited" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="+ Add ▾">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Node" Command="{Binding AddNodeCommand}" />
                                <MenuItem Header="Entity" Command="{Binding AddEntityCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Run" Command="{Binding RunCommand}" Classes="ghost" />
                    <Border Width="1" Background="{StaticResource SeparatorBrush}" Margin="4,2" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" Classes="ghost" ToolTip.Tip="Undo (Ctrl/Cmd+Z)" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" Classes="ghost" ToolTip.Tip="Redo (Ctrl+Y / Cmd+Shift+Z)" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton Content="Snap" Classes="ghost" IsChecked="{Binding SnapToGrid}"
                                  ToolTip.Tip="Snap nodes to grid" />
                    <Border Width="1" Background="{StaticResource SeparatorBrush}" Margin="4,2" />
                    <Button Content="−" Command="{Binding ZoomOutCommand}" Classes="ghost" ToolTip.Tip="Zoom out" />
                    <Button Content="Fit" Command="{Binding ZoomToFitCommand}" Classes="ghost"
                            ToolTip.Tip="Zoom to fit" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" Classes="ghost" ToolTip.Tip="Zoom in" />
                    <Button Content="Save" Click="OnSaveClick" Classes="accent" />
                    <Button Content="Export" Click="OnExportClick" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CANVAS + INSPECTOR ============ -->
        <Grid>
            <!-- Viewport: receives pan / zoom / background interactions -->
            <Border x:Name="Viewport" Background="{StaticResource CanvasBgBrush}" ClipToBounds="True"
                    PointerPressed="OnViewportPressed" PointerMoved="OnViewportMoved"
                    PointerReleased="OnViewportReleased" PointerWheelChanged="OnViewportWheel">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Create Node" Click="OnCreateNodeClick" />
                        <MenuItem Header="Create Entity" Click="OnCreateEntityClick" />
                    </ContextMenu>
                </Border.ContextMenu>

                <!-- World space (pan + zoom applied here). It's a large fixed canvas
                     (NodeLayout.CanvasSize) whose CENTRE is world origin: cards are laid
                     out at world + CanvasBias so they always sit inside the canvas bounds
                     and Avalonia never culls them, in any drag direction. The translate
                     subtracts CanvasBias*Zoom (RenderOffset) so the view is unchanged. -->
                <Panel x:Name="World" Width="{x:Static vm:NodeLayout.CanvasSize}"
                       Height="{x:Static vm:NodeLayout.CanvasSize}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       ClipToBounds="False" RenderTransformOrigin="0,0">
                    <Panel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            <TranslateTransform X="{Binding RenderOffsetX}" Y="{Binding RenderOffsetY}" />
                        </TransformGroup>
                    </Panel.RenderTransform>

                    <!-- Wires (behind nodes) -->
                    <ItemsControl ItemsSource="{Binding Connections}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{x:Static vm:NodeLayout.CanvasSize}" Height="{x:Static vm:NodeLayout.CanvasSize}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionViewModel">
                                <Grid>
                                    <Path Data="{Binding Geometry}" Stroke="{Binding Stroke}"
                                          StrokeThickness="2" />
                                    <Path Data="M 0,0 L -10,-6 M 0,0 L -10,6"
                                          Stroke="{Binding Stroke}" StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="{Binding ArrowTip.X}"
                                                                     Y="{Binding ArrowTip.Y}" />
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Temp wire shown while dragging a connection -->
                    <Path x:Name="TempWire" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2"
                          StrokeDashArray="4,3" IsVisible="False" />

                    <!-- Entity cards (node-like layout, blue theme) -->
                    <ItemsControl ItemsSource="{Binding Entities}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{x:Static vm:NodeLayout.CanvasSize}" Height="{x:Static vm:NodeLayout.CanvasSize}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="vm:EntityViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntityViewModel">
                                <Border Classes="card entity"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.hidden="{Binding !Visible}">
                                    <StackPanel>
                                        <!-- Header (entity accent) — draggable -->
                                        <Panel Height="34" PointerPressed="OnEntityHeaderPressed">
                                            <Border CornerRadius="10,10,0,0" Background="{StaticResource EntityHeaderBrush}" />
                                            <Grid ColumnDefinitions="*,Auto" Margin="14,0,6,0">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                                <ToggleButton Grid.Column="1" Classes="visibility"
                                                              IsChecked="{Binding Visible}"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="Shown at runtime">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="White"
                                                          Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                                </ToggleButton>
                                            </Grid>
                                        </Panel>

                                        <!-- Component rows — clickable -->
                                        <ItemsControl ItemsSource="{Binding Components}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ComponentViewModel">
                                                    <Border Margin="8,3,8,0" Padding="8,4"
                                                            Background="{StaticResource ControlBgBrush}"
                                                            CornerRadius="6" Classes="row"
                                                            Classes.hidden="{Binding !Visible}"
                                                            PointerPressed="OnComponentBadgePressed">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                            <Border Grid.Column="0" Background="{StaticResource EntityAccentBrush}"
                                                                    CornerRadius="3" Width="18" Height="18"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Text="{Binding ComponentType, Converter={StaticResource ComponentTypeIcon}}"
                                                                           ToolTip.Tip="{Binding ComponentType}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <ToggleButton Grid.Column="2" Classes="visibility"
                                                                          IsChecked="{Binding Visible}"
                                                                          VerticalAlignment="Center"
                                                                          ToolTip.Tip="Shown at runtime">
                                                                <Path Width="12" Height="12" Stretch="Uniform"
                                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                                      Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                                            </ToggleButton>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Component" Classes="ghost" Margin="8,4,8,8"
                                                HorizontalAlignment="Stretch" FontSize="11"
                                                Click="OnAddComponentClick"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nodes -->
                    <ItemsControl ItemsSource="{Binding Nodes}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{x:Static vm:NodeLayout.CanvasSize}" Height="{x:Static vm:NodeLayout.CanvasSize}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="vm:NodeViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NodeViewModel">
                                <Border Classes="card node"
                                        Classes.selected="{Binding IsSelected}">
                                    <StackPanel>
                                        <!-- Header -->
                                        <Panel Height="{x:Static vm:NodeLayout.HeaderHeight}" PointerPressed="OnNodeHeaderPressed">
                                            <Border CornerRadius="10,10,0,0" Background="{StaticResource HeaderOverlayBrush}" />
                                            <TextBlock Text="{Binding Id}" Margin="14,0" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <!-- Input pin -->
                                            <Ellipse Width="12" Height="12" Margin="-6,0,0,0"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Fill="{StaticResource ControlBgBrush}"
                                                     Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                     PointerPressed="OnInputPinPressed" />
                                        </Panel>

                                        <!-- Display text -->
                                        <Border Height="{x:Static vm:NodeLayout.TextAreaHeight}" Padding="8,4">
                                            <TextBox Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                     AcceptsReturn="True" FontSize="12" BorderThickness="0"
                                                     Background="Transparent" Padding="4" />
                                        </Border>

                                        <!-- Choices -->
                                        <ItemsControl ItemsSource="{Binding Choices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChoiceViewModel">
                                                    <Panel Height="{x:Static vm:NodeLayout.ChoiceRowHeight}">
                                                        <!-- Each choice is its own block -->
                                                        <Border Margin="8,5,14,5"
                                                                Background="{StaticResource ControlBgBrush}"
                                                                CornerRadius="6" Padding="6,0"
                                                                Classes.selected="{Binding IsSelected}">
                                                            <Border.Styles>
                                                                <Style Selector="Border.selected">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </Style>
                                                            </Border.Styles>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBox Grid.Column="0" Text="{Binding DisplayText}"
                                                                         FontSize="11" Padding="4,2"
                                                                         Background="Transparent" BorderThickness="0"
                                                                         VerticalContentAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            Spacing="2" VerticalAlignment="Center">
                                                                    <Button Content="⚙" Classes="icon"
                                                                            Command="{Binding OpenInspectorCommand}"
                                                                            ToolTip.Tip="Edit choice" />
                                                                    <Button Content="✕" Classes="icon danger"
                                                                            Command="{Binding RemoveSelfCommand}"
                                                                            ToolTip.Tip="Remove choice" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Output pin -->
                                                        <Ellipse Width="12" Height="12" Margin="0,0,-6,0"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                 Fill="{StaticResource AccentBrush}"
                                                                 PointerPressed="OnOutputPinPressed" />
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ choice" Classes="ghost" Margin="8,4,8,8"
                                                HorizontalAlignment="Stretch" FontSize="11"
                                                Command="{Binding AddChoiceViaEditorCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Border>

            <!-- ============ RIGHT INSPECTOR (single host) ============ -->
            <!-- Drag the grip on the left edge to resize (OnInspectorResize clamps the
                 width); the ScrollViewer scrolls horizontally when a deep condition tree
                 is still wider than the chosen width. -->
            <Grid x:Name="InspectorHost" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto"
                  IsVisible="{Binding SelectedInspectorTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Thumb Grid.Column="0" x:Name="InspectorResizeGrip" Width="6"
                       Background="Transparent" Cursor="SizeWestEast"
                       DragDelta="OnInspectorResize" ToolTip.Tip="Drag to resize">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="Transparent">
                                <Rectangle Width="1" HorizontalAlignment="Center"
                                           Fill="{StaticResource SeparatorBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Border Grid.Column="1" x:Name="InspectorPanel" Width="280" Margin="0"
                    Background="{StaticResource ContentBgBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedInspectorTarget}"
                                    HorizontalAlignment="Left" MinWidth="278">
                        <ContentControl.DataTemplates>

                            <!-- ── Node inspector ── -->
                            <DataTemplate x:DataType="vm:NodeViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <TextBlock Text="Node" Classes="inspector-title" />
                                    <TextBlock Text="ID" Classes="field-label" />
                                    <TextBox Text="{Binding Id}" />
                                    <TextBlock Text="Display text" Classes="field-label" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding DisplayText}" TextWrapping="Wrap" AcceptsReturn="True"
                                             MinHeight="90" />
                                    <Button Content="Delete node" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Choice inspector ── -->
                            <DataTemplate x:DataType="vm:ChoiceViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <TextBlock Text="Choice" Classes="inspector-title" />
                                    <TextBlock Text="Display text" Classes="field-label" />
                                    <TextBox Text="{Binding DisplayText}" TextWrapping="Wrap" MinHeight="40" />

                                    <TextBlock Text="Commands" Classes="section" />

                                    <ItemsControl ItemsSource="{Binding Commands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommandViewModel">
                                                <Border Margin="0,2" Padding="6"
                                                        Background="{StaticResource ControlBgBrush}"
                                                        CornerRadius="6">
                                                    <StackPanel Spacing="4">
                                                        <ComboBox ItemsSource="{Binding AvailableEntities}"
                                                                  SelectedItem="{Binding TargetEntity}"
                                                                  DisplayMemberBinding="{Binding Name}"
                                                                  PlaceholderText="Entity" FontSize="11" />

                                                        <ComboBox ItemsSource="{Binding AvailableComponents}"
                                                                  SelectedItem="{Binding SelectedComponent}"
                                                                  DisplayMemberBinding="{Binding Name}"
                                                                  PlaceholderText="Component" FontSize="11" />

                                                        <ComboBox ItemsSource="{Binding AvailableFields}"
                                                                  SelectedIndex="{Binding SelectedFieldIndex}"
                                                                  FontSize="11" Margin="0,2,0,0"
                                                                  IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='number'}" />

                                                        <NumericUpDown Value="{Binding NumberValue}"
                                                                       Minimum="0" Maximum="999999"
                                                                       FormatString="0.##"
                                                                       FontSize="11" Margin="0,2,0,0"
                                                                       IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='number'}" />

                                                        <TextBox Text="{Binding TextValue}"
                                                                 PlaceholderText="Enter text" FontSize="11"
                                                                 Margin="0,2,0,0"
                                                                 IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='text'}" />

                                                        <!-- Condition value — toggle switch instead of true/false dropdown -->
                                                        <ToggleSwitch IsChecked="{Binding BoolValue}"
                                                                      Margin="0,2,0,0"
                                                                      IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='condition'}" />

                                                        <!-- Condition (optional): only run this command when it holds -->
                                                        <TextBlock Text="Condition (optional)" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,6,0,0" />

                                                        <Button Content="+ Add condition" Classes="ghost" FontSize="10"
                                                                HorizontalAlignment="Stretch"
                                                                IsVisible="{Binding !HasCondition}"
                                                                Command="{Binding AddConditionCommand}" />

                                                        <StackPanel Spacing="4" IsVisible="{Binding HasCondition}">
                                                            <ContentControl Content="{Binding ConditionRoot}" />
                                                            <Button Content="Remove condition" Classes="danger" FontSize="10"
                                                                    HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                                                    Command="{Binding RemoveConditionSelfCommand}" />
                                                        </StackPanel>

                                                        <Button Content="✕ Remove" Classes="danger"
                                                                HorizontalAlignment="Right" FontSize="10"
                                                                Padding="8,3" Margin="0,4,0,0"
                                                                Command="{Binding RemoveSelfCommand}"
                                                                ToolTip.Tip="Remove command" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ Command" Classes="ghost" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch" FontSize="11"
                                            Command="{Binding AddCommandCommand}" />

                                    <!-- Condition (optional) -->
                                    <TextBlock Text="Condition (optional)" Classes="section" />

                                    <Button Content="+ Add condition" Classes="ghost"
                                            HorizontalAlignment="Stretch" FontSize="11"
                                            IsVisible="{Binding !HasCondition}"
                                            Command="{Binding AddConditionCommand}" />

                                    <StackPanel Spacing="6" IsVisible="{Binding HasCondition}">
                                        <ContentControl Content="{Binding ConditionRoot}" />

                                        <TextBlock Text="If condition is false" Classes="field-label"
                                                   Margin="0,4,0,0" />
                                        <ComboBox ItemsSource="{Binding FalseBehaviorOptions}"
                                                  SelectedIndex="{Binding SelectedFalseBehaviorIndex}"
                                                  FontSize="11" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Close = shown but not selectable; Hide = removed" />

                                        <Button Content="Remove condition" Classes="danger"
                                                HorizontalAlignment="Stretch" FontSize="11" Margin="0,4,0,0"
                                                Command="{Binding RemoveConditionSelfCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Entity inspector ── -->
                            <DataTemplate x:DataType="vm:EntityViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <TextBlock Text="Entity" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <TextBlock Text="ID" Classes="field-label" />
                                    <TextBox Text="{Binding Id}" IsReadOnly="True" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>

                                    <TextBlock Text="Components" Classes="section" />

                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComponentViewModel">
                                                <Border Margin="0,2" Padding="6"
                                                        Background="{StaticResource ControlBgBrush}"
                                                        CornerRadius="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                                   Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="✕" Classes="icon danger"
                                                                Command="{Binding RemoveSelfCommand}"
                                                                ToolTip.Tip="Remove component" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Delete entity" Classes="danger" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Number component editor ── -->
                            <DataTemplate x:DataType="vm:NumberComponentViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <!-- Breadcrumb back to entity -->
                                    <Button Content="‹ Back to entity" Classes="ghost" FontSize="11" Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding BackToEntityCommand}" />
                                    <TextBlock Text="Number Component" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>
                                    <Separator Margin="0,4" />
                                    <TextBlock Text="Initial Value" Classes="field-label" />
                                    <NumericUpDown Value="{Binding Value}"
                                                   Minimum="{Binding MinValue}" Maximum="{Binding MaxValue, Converter={StaticResource NumericSafe}}"
                                                   FormatString="0.##" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="Min Value" Classes="field-label" Margin="0,8,0,0" />
                                    <NumericUpDown Value="{Binding MinValue}" FormatString="0.##" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="Max Value" Classes="field-label" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding MaxValue, Converter={StaticResource MaxValueDisplay}}"
                                             FontSize="11" Margin="0,2,0,0" />
                                    <Button Content="Remove component" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Text component editor ── -->
                            <DataTemplate x:DataType="vm:TextComponentViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <Button Content="‹ Back to entity" Classes="ghost" FontSize="11" Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding BackToEntityCommand}" />
                                    <TextBlock Text="Text Component" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>
                                    <Separator Margin="0,4" />
                                    <TextBlock Text="Initial Value" Classes="field-label" />
                                    <TextBox Text="{Binding Value}" TextWrapping="Wrap" AcceptsReturn="True"
                                             MinHeight="60" FontSize="11" Margin="0,2,0,0" />
                                    <Button Content="Remove component" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Condition component editor ── -->
                            <DataTemplate x:DataType="vm:ConditionComponentViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <Button Content="‹ Back to entity" Classes="ghost" FontSize="11" Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding BackToEntityCommand}" />
                                    <TextBlock Text="Condition Component" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>
                                    <Separator Margin="0,4" />
                                    <TextBlock Text="Initial Value" Classes="field-label" />
                                    <ToggleSwitch IsChecked="{Binding Value}" Margin="0,2,0,0" />
                                    <Button Content="Remove component" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
                </Border>
            </Grid>

            <!-- Empty-graph hint -->
            <StackPanel IsVisible="{Binding !HasNodes}" IsHitTestVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="No nodes yet" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Right-click the canvas or press “+ Add Node”."
                           FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

        </Grid>
    </DockPanel>
</UserControl>