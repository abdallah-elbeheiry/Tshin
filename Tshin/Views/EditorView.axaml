<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tshin.ViewModels"
             xmlns:conv="clr-namespace:Tshin.Converters"
             xmlns:views="clr-namespace:Tshin.Views"
             x:Class="Tshin.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             Focusable="True">

    <UserControl.Resources>
        <conv:ComponentTypeToIconConverter x:Key="ComponentTypeIcon" />
        <conv:ComponentTypeVisibilityConverter x:Key="ComponentTypeVisibility" />
        <conv:BoolToGeometryConverter x:Key="BoolToGeometry" />
        <conv:NumericSafeConverter x:Key="NumericSafe" />
        <conv:MaxValueConverter x:Key="MaxValueDisplay" />
    </UserControl.Resources>

    <!-- Implicit (type-keyed) templates for the recursive condition editor. The group
         template hosts an ItemsControl over Children with NO ItemTemplate, so each child
         falls back to these implicit templates → the AND/OR nesting renders recursively. -->
    <UserControl.DataTemplates>

        <!-- Atomic condition: entity → component → operator → value -->
        <DataTemplate x:DataType="vm:AtomicConditionViewModel">
            <Border Margin="0,2" Padding="6"
                    Background="{DynamicResource ControlBgBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Condition" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon danger"
                                Command="{Binding RemoveSelfCommand}"
                                ToolTip.Tip="Remove condition">
                            <Path Classes="glyph" Data="{StaticResource CloseIcon}" />
                        </Button>
                    </Grid>

                    <ComboBox ItemsSource="{Binding AvailableEntities}"
                              SelectedItem="{Binding TargetEntity}"
                              DisplayMemberBinding="{Binding Name}"
                              PlaceholderText="Entity" FontSize="11"
                              HorizontalAlignment="Stretch" />

                    <ComboBox ItemsSource="{Binding AvailableComponents}"
                              SelectedItem="{Binding SelectedComponent}"
                              DisplayMemberBinding="{Binding Name}"
                              PlaceholderText="Component" FontSize="11"
                              HorizontalAlignment="Stretch" />

                    <ComboBox ItemsSource="{Binding AvailableOperators}"
                              SelectedItem="{Binding SelectedOperator}"
                              PlaceholderText="Operator" FontSize="11"
                              HorizontalAlignment="Stretch" />

                    <NumericUpDown Value="{Binding NumberValue}"
                                   FormatString="0.##" FontSize="11" Margin="0,2,0,0"
                                   IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='number'}" />

                    <TextBox Text="{Binding TextValue}"
                             PlaceholderText="Enter text" FontSize="11" Margin="0,2,0,0"
                             IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='text'}" />

                    <ToggleSwitch IsChecked="{Binding BoolValue}" Margin="0,2,0,0"
                                  IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='condition'}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Logical group: AND/OR selector + recursive children + add buttons -->
        <DataTemplate x:DataType="vm:LogicalGroupViewModel">
            <Border Margin="0,2" Padding="6"
                    Background="{DynamicResource ControlBgBrush}" CornerRadius="6"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding LogicOptions}"
                                  SelectedIndex="{Binding SelectedLogicIndex}"
                                  FontSize="11" ToolTip.Tip="AND = all must hold; OR = any holds" />
                        <TextBlock Grid.Column="1" Text="group" FontSize="10" Margin="6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="2" Classes="icon danger"
                                Command="{Binding RemoveSelfCommand}"
                                ToolTip.Tip="Remove group">
                            <Path Classes="glyph" Data="{StaticResource CloseIcon}" />
                        </Button>
                    </Grid>

                    <!-- Recursive children: no ItemTemplate → implicit templates apply -->
                    <ItemsControl ItemsSource="{Binding Children}" Margin="12,0,0,0" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="+ Condition" Classes="ghost" FontSize="10"
                                Command="{Binding AddAtomicCommand}" />
                        <Button Content="+ Group" Classes="ghost" FontSize="10"
                                Command="{Binding AddGroupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.DataTemplates>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Meta+R" Command="{Binding RunCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RunCommand}" />
        <KeyBinding Gesture="Meta+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <!-- ============ TOOLBAR ============ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ContentBgBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="16,10" Margin="{DynamicResource TitleBarInset}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox Text="{Binding ProjectName}" Classes="title"
                             FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                             MinWidth="60" MaxWidth="280"
                             ToolTip.Tip="Rename epic" />
                    <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="4" Padding="6,1"
                            VerticalAlignment="Center" IsVisible="{Binding IsDirty}">
                        <TextBlock Text="Edited" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="ghost">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                            <Path Classes="glyph" MaxWidth="9" MaxHeight="9" VerticalAlignment="Center"
                                  Data="{StaticResource ChevronDownIcon}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Node" Command="{Binding AddNodeCommand}" />
                                <MenuItem Header="Entity" Command="{Binding AddEntityCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Run" Command="{Binding RunCommand}" Classes="ghost" />
                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,2" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" Classes="ghost" ToolTip.Tip="Undo (Ctrl/Cmd+Z)" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" Classes="ghost" ToolTip.Tip="Redo (Ctrl+Y / Cmd+Shift+Z)" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton Content="Snap" Classes="ghost" IsChecked="{Binding SnapToGrid}"
                                  ToolTip.Tip="Snap nodes to grid" />
                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,2" />
                    <Button Command="{Binding ZoomOutCommand}" Classes="ghost" ToolTip.Tip="Zoom out"
                            Width="36" VerticalAlignment="Stretch">
                        <Path Classes="glyph" Data="{StaticResource MinusIcon}" />
                    </Button>
                    <Button Content="Fit" Command="{Binding ZoomToFitCommand}" Classes="ghost"
                            ToolTip.Tip="Zoom to fit" />
                    <Button Command="{Binding ZoomInCommand}" Classes="ghost" ToolTip.Tip="Zoom in"
                            Width="36" VerticalAlignment="Stretch">
                        <Path Classes="glyph" Data="{StaticResource PlusIcon}" />
                    </Button>
                    <Button Content="Save" Click="OnSaveClick" Classes="accent" />
                    <Button Content="Export" Click="OnExportClick" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CANVAS + INSPECTOR ============ -->
        <Grid>
            <views:CanvasView />

            <!-- ============ RIGHT INSPECTOR (single host) ============ -->
            <!-- Drag the grip on the left edge to resize (OnInspectorResize clamps the
                 width); the ScrollViewer scrolls horizontally when a deep condition tree
                 is still wider than the chosen width. -->
            <Grid x:Name="InspectorHost" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto"
                  IsVisible="{Binding SelectedInspectorTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Thumb Grid.Column="0" x:Name="InspectorResizeGrip" Width="6"
                       Background="Transparent" Cursor="SizeWestEast"
                       DragDelta="OnInspectorResize" ToolTip.Tip="Drag to resize">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="Transparent">
                                <Rectangle Width="1" HorizontalAlignment="Center"
                                           Fill="{DynamicResource SeparatorBrush}" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Border Grid.Column="1" x:Name="InspectorPanel" Width="280" Margin="0"
                    Background="{DynamicResource ContentBgBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedInspectorTarget}"
                                    HorizontalAlignment="Left" MinWidth="278">
                        <ContentControl.DataTemplates>

                            <!-- ── Node inspector ── -->
                            <DataTemplate x:DataType="vm:NodeViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <TextBlock Text="Node" Classes="inspector-title" />
                                    <TextBlock Text="ID" Classes="field-label" />
                                    <TextBox Text="{Binding Id}" />
                                    <TextBlock Text="Display text" Classes="field-label" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding DisplayText}" TextWrapping="Wrap" AcceptsReturn="True"
                                             MinHeight="90" />
                                    <Button Content="Delete node" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Choice inspector ── -->
                            <DataTemplate x:DataType="vm:ChoiceViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <TextBlock Text="Choice" Classes="inspector-title" />
                                    <TextBlock Text="Display text" Classes="field-label" />
                                    <TextBox Text="{Binding DisplayText}" TextWrapping="Wrap" MinHeight="40" />

                                    <TextBlock Text="Commands" Classes="section" />

                                    <ItemsControl ItemsSource="{Binding Commands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommandViewModel">
                                                <Border Margin="0,2" Padding="6"
                                                        Background="{DynamicResource ControlBgBrush}"
                                                        CornerRadius="6">
                                                    <StackPanel Spacing="4">
                                                        <ComboBox ItemsSource="{Binding AvailableEntities}"
                                                                  SelectedItem="{Binding TargetEntity}"
                                                                  DisplayMemberBinding="{Binding Name}"
                                                                  PlaceholderText="Entity" FontSize="11" />

                                                        <ComboBox ItemsSource="{Binding AvailableComponents}"
                                                                  SelectedItem="{Binding SelectedComponent}"
                                                                  DisplayMemberBinding="{Binding Name}"
                                                                  PlaceholderText="Component" FontSize="11" />

                                                        <ComboBox ItemsSource="{Binding AvailableFields}"
                                                                  SelectedIndex="{Binding SelectedFieldIndex}"
                                                                  FontSize="11" Margin="0,2,0,0"
                                                                  IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='number'}" />

                                                        <NumericUpDown Value="{Binding NumberValue}"
                                                                       Minimum="0" Maximum="999999"
                                                                       FormatString="0.##"
                                                                       FontSize="11" Margin="0,2,0,0"
                                                                       IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='number'}" />

                                                        <TextBox Text="{Binding TextValue}"
                                                                 PlaceholderText="Enter text" FontSize="11"
                                                                 Margin="0,2,0,0"
                                                                 IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='text'}" />

                                                        <!-- Condition value — toggle switch instead of true/false dropdown -->
                                                        <ToggleSwitch IsChecked="{Binding BoolValue}"
                                                                      Margin="0,2,0,0"
                                                                      IsVisible="{Binding TargetComponentType, Converter={StaticResource ComponentTypeVisibility}, ConverterParameter='condition'}" />

                                                        <!-- Condition (optional): only run this command when it holds -->
                                                        <TextBlock Text="Condition (optional)" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,6,0,0" />

                                                        <Button Content="+ Add condition" Classes="ghost" FontSize="10"
                                                                HorizontalAlignment="Stretch"
                                                                IsVisible="{Binding !HasCondition}"
                                                                Command="{Binding AddConditionCommand}" />

                                                        <StackPanel Spacing="4" IsVisible="{Binding HasCondition}">
                                                            <ContentControl Content="{Binding ConditionRoot}" />
                                                            <Button Content="Remove condition" Classes="danger" FontSize="10"
                                                                    HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                                                    Command="{Binding RemoveConditionSelfCommand}" />
                                                        </StackPanel>

                                                        <Button Content="✕ Remove" Classes="danger"
                                                                HorizontalAlignment="Right" FontSize="10"
                                                                Padding="8,3" Margin="0,4,0,0"
                                                                Command="{Binding RemoveSelfCommand}"
                                                                ToolTip.Tip="Remove command" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ Command" Classes="ghost" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch" FontSize="11"
                                            Command="{Binding AddCommandCommand}" />

                                    <!-- Condition (optional) -->
                                    <TextBlock Text="Condition (optional)" Classes="section" />

                                    <Button Content="+ Add condition" Classes="ghost"
                                            HorizontalAlignment="Stretch" FontSize="11"
                                            IsVisible="{Binding !HasCondition}"
                                            Command="{Binding AddConditionCommand}" />

                                    <StackPanel Spacing="6" IsVisible="{Binding HasCondition}">
                                        <ContentControl Content="{Binding ConditionRoot}" />

                                        <TextBlock Text="If condition is false" Classes="field-label"
                                                   Margin="0,4,0,0" />
                                        <ComboBox ItemsSource="{Binding FalseBehaviorOptions}"
                                                  SelectedIndex="{Binding SelectedFalseBehaviorIndex}"
                                                  FontSize="11" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Close = shown but not selectable; Hide = removed" />

                                        <Button Content="Remove condition" Classes="danger"
                                                HorizontalAlignment="Stretch" FontSize="11" Margin="0,4,0,0"
                                                Command="{Binding RemoveConditionSelfCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Entity inspector ── -->
                            <DataTemplate x:DataType="vm:EntityViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <TextBlock Text="Entity" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <TextBlock Text="ID" Classes="field-label" />
                                    <TextBox Text="{Binding Id}" IsReadOnly="True" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>

                                    <TextBlock Text="Components" Classes="section" />

                                    <ItemsControl ItemsSource="{Binding Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComponentViewModel">
                                                <Border Margin="0,2" Padding="6"
                                                        Background="{DynamicResource ControlBgBrush}"
                                                        CornerRadius="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                                   Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Classes="icon danger"
                                                                Command="{Binding RemoveSelfCommand}"
                                                                ToolTip.Tip="Remove component">
                                                            <Path Classes="glyph" Data="{StaticResource CloseIcon}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Delete entity" Classes="danger" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Number component editor ── -->
                            <DataTemplate x:DataType="vm:NumberComponentViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <!-- Breadcrumb back to entity -->
                                    <Button Content="‹ Back to entity" Classes="ghost" FontSize="11" Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding BackToEntityCommand}" />
                                    <TextBlock Text="Number Component" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>
                                    <Separator Margin="0,4" />
                                    <TextBlock Text="Initial Value" Classes="field-label" />
                                    <NumericUpDown Value="{Binding Value}"
                                                   Minimum="{Binding MinValue}" Maximum="{Binding MaxValue, Converter={StaticResource NumericSafe}}"
                                                   FormatString="0.##" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="Min Value" Classes="field-label" Margin="0,8,0,0" />
                                    <NumericUpDown Value="{Binding MinValue}" FormatString="0.##" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock Text="Max Value" Classes="field-label" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding MaxValue, Converter={StaticResource MaxValueDisplay}}"
                                             FontSize="11" Margin="0,2,0,0" />
                                    <Button Content="Remove component" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Text component editor ── -->
                            <DataTemplate x:DataType="vm:TextComponentViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <Button Content="‹ Back to entity" Classes="ghost" FontSize="11" Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding BackToEntityCommand}" />
                                    <TextBlock Text="Text Component" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>
                                    <Separator Margin="0,4" />
                                    <TextBlock Text="Initial Value" Classes="field-label" />
                                    <TextBox Text="{Binding Value}" TextWrapping="Wrap" AcceptsReturn="True"
                                             MinHeight="60" FontSize="11" Margin="0,2,0,0" />
                                    <Button Content="Remove component" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- ── Condition component editor ── -->
                            <DataTemplate x:DataType="vm:ConditionComponentViewModel">
                                <StackPanel Margin="16" Spacing="6">
                                    <Button Content="‹ Back to entity" Classes="ghost" FontSize="11" Margin="0,0,0,4"
                                            HorizontalAlignment="Left"
                                            Command="{Binding BackToEntityCommand}" />
                                    <TextBlock Text="Condition Component" Classes="inspector-title" />
                                    <TextBlock Text="Name" Classes="field-label" />
                                    <TextBox Text="{Binding Name}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Visible" Classes="field-label"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="1" Classes="visibility"
                                                      IsChecked="{Binding Visible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip.Tip="Shown at runtime">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{Binding Visible, Converter={StaticResource BoolToGeometry}, ConverterParameter='EyeOpenIcon|EyeClosedIcon'}" />
                                        </ToggleButton>
                                    </Grid>
                                    <Separator Margin="0,4" />
                                    <TextBlock Text="Initial Value" Classes="field-label" />
                                    <ToggleSwitch IsChecked="{Binding Value}" Margin="0,2,0,0" />
                                    <Button Content="Remove component" Classes="danger" Margin="0,12,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemoveSelfCommand}" />
                                </StackPanel>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
                </Border>
            </Grid>

            <!-- Empty-graph hint -->
            <StackPanel IsVisible="{Binding !HasNodes}" IsHitTestVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="No nodes yet" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Right-click the canvas or press “+ Add Node”."
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

        </Grid>
    </DockPanel>
</UserControl>