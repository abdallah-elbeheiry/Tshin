<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Tshin.Behaviors"
        x:Class="Tshin.Views.TextEditorWindow"
        Title="Text Editor"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Editor pane -->
        <TextBox Grid.Column="0" x:Name="EditorTextBox"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Padding="12" FontSize="14"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 Background="{StaticResource ControlBgBrush}"
                 BorderThickness="0"
                 behaviors:TextBoxFormattingBehavior.EnableFormattingMenu="True"
                 behaviors:TextBoxCompletionBehavior.EnableVariableCompletion="True" />

        <!-- Splitter (draggable barrier) -->
        <GridSplitter Grid.Column="1" Width="4"
                      Background="{StaticResource SeparatorBrush}" />

        <!-- Preview pane -->
        <ScrollViewer Grid.Column="2" Padding="16"
                      Background="{StaticResource ContentBgBrush}">
            <TextBlock x:Name="PreviewTextBlock"
                       FontSize="18"
                       TextWrapping="Wrap"
                       LineHeight="26"
                       behaviors:BbCodeProperties.BbCodeText="" />
        </ScrollViewer>
    </Grid>
</Window>
