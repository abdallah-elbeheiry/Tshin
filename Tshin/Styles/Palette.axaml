<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- macOS-flavoured dark design tokens. -->

    <!-- Surfaces -->
    <Color x:Key="WindowBgColor">#1C1C1E</Color>
    <Color x:Key="SidebarBgColor">#242426</Color>
    <Color x:Key="ContentBgColor">#1E1E1E</Color>
    <Color x:Key="CanvasBgColor">#161618</Color>
    <Color x:Key="CardBgColor">#2C2C2E</Color>
    <Color x:Key="CardBgHoverColor">#343436</Color>
    <Color x:Key="ControlBgColor">#3A3A3C</Color>

    <!-- Accent (macOS system blue) — used for nodes / primary actions -->
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentHoverColor">#409CFF</Color>

    <!-- Entity accent (macOS system indigo) — distinct from nodes, same cool family -->
    <Color x:Key="EntityAccentColor">#5E5CE6</Color>
    <Color x:Key="EntityHeaderColor">#4340B5</Color>

    <!-- Danger (muted red) — destructive actions -->
    <Color x:Key="DangerColor">#C53030</Color>
    <Color x:Key="DangerHoverColor">#E04040</Color>
    <Color x:Key="DangerSubtleColor">#2A1A1A</Color>

    <!-- Neutral header overlay applied on top of a card header -->
    <Color x:Key="HeaderOverlayColor">#33000000</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#98989D</Color>
    <Color x:Key="TextTertiaryColor">#6E6E73</Color>

    <!-- Lines -->
    <Color x:Key="SeparatorColor">#3A3A3C</Color>
    <Color x:Key="ControlBorderColor">#48484A</Color>
    
    <!-- Wire colors -->
    <Color x:Key="WireColor0">#0A84FF</Color>
    <Color x:Key="WireColor1">#5E5CE6</Color>
    <Color x:Key="WireColor2">#30D158</Color>
    <Color x:Key="WireColor3">#FF9F0A</Color>
    <Color x:Key="WireColor4">#FF375F</Color>
    <Color x:Key="WireColor5">#64D2FF</Color>
    <Color x:Key="WireColor6">#BF5AF2</Color>


    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" Opacity="0.85" />
    <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBgColor}" />
    <SolidColorBrush x:Key="CanvasBgBrush" Color="{StaticResource CanvasBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardBgHoverBrush" Color="{StaticResource CardBgHoverColor}" />
    <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="EntityAccentBrush" Color="{StaticResource EntityAccentColor}" />
    <SolidColorBrush x:Key="EntityHeaderBrush" Color="{StaticResource EntityHeaderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
    <SolidColorBrush x:Key="HeaderOverlayBrush" Color="{StaticResource HeaderOverlayColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />

    <!-- Fluent ToggleSwitch: recolour the "on" track to our accent -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource AccentColor}" />

    <!-- Wire palette (alternating colours for connection lines, 7 distinct hues) -->
    <SolidColorBrush x:Key="WireBrush0" Color="{StaticResource WireColor0}" />
    <SolidColorBrush x:Key="WireBrush1" Color="{StaticResource WireColor1}" />
    <SolidColorBrush x:Key="WireBrush2" Color="{StaticResource WireColor2}" />
    <SolidColorBrush x:Key="WireBrush3" Color="{StaticResource WireColor3}" />
    <SolidColorBrush x:Key="WireBrush4" Color="{StaticResource WireColor4}" />
    <SolidColorBrush x:Key="WireBrush5" Color="{StaticResource WireColor5}" />
    <SolidColorBrush x:Key="WireBrush6" Color="{StaticResource WireColor6}" />

    <!-- Icons (SVG path data) -->
    <!-- Open in new window: box with diagonal arrow -->
    <StreamGeometry x:Key="OpenInNewIcon">M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>
    <!-- Eye open: oval outline with circle iris -->
    <StreamGeometry x:Key="EyeOpenIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
    <!-- Eye closed: line through with lashes -->
    <StreamGeometry x:Key="EyeClosedIcon">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46A11.8 11.8 0 001 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>

    <!-- Metrics -->
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <Thickness x:Key="TitleBarInset">0,30,0,0</Thickness>
</ResourceDictionary>
